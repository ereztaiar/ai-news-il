data/news.db
data/news.db-journal
data/news.db-wal
data/news.db-shm
.pipeline.lock

# Python
__pycache__/
*.pyc

# TypeScript incremental build info
*.tsbuildinfo

# Claude Code local/session-specific state (not project config)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Scratch/debug artifacts, not part of the pipeline
.scratch/
undefined/
